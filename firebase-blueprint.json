{
  "entities": {
    "Project": {
      "title": "Warehouse Monitoring Project",
      "description": "A warehouse or operational site whose materials are monitored in real-time.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Official name of the warehouse or project."
        },
        "location": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "City or site address."
        },
        "managerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Warehouse lead or operations manager."
        },
        "status": {
          "type": "string",
          "enum": ["active", "paused", "completed"],
          "description": "Current operational state."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the user who owns this project."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated."
        }
      },
      "required": ["name", "location", "managerName", "status", "ownerId", "createdAt", "updatedAt"]
    },
    "DivisionBreakdown": {
      "title": "Division Quantity Breakdown",
      "description": "Quantities split across DIST, AGA, TE, and TOTAL.",
      "type": "object",
      "properties": {
        "dist": { "type": "number" },
        "aga": { "type": "number" },
        "te": { "type": "number" },
        "total": { "type": "number" }
      },
      "required": ["dist", "aga", "te", "total"]
    },
    "Material": {
      "title": "Warehouse Material",
      "description": "Material item aligned with warehouse ledger columns (No, Gudang, No Material, Nama Material, Satuan, Stok Awal, Masuk, Keluar, Stok Akhir, Keterangan).",
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "rowNumber": {
          "type": "number"
        },
        "sku": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9\\-_]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "enum": [
            "kWh Meter & AMR",
            "MCB, Fuse & Proteksi",
            "Kabel & Konduktor",
            "Box, Panel & LVSB",
            "Tiang, Isolator & Konektor",
            "Peralatan & Aksesoris"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "currentStock": {
          "type": "number"
        },
        "stokAwal": {
          "$ref": "#/entities/DivisionBreakdown",
          "type": "object"
        },
        "materialMasuk": {
          "$ref": "#/entities/DivisionBreakdown",
          "type": "object"
        },
        "materialKeluar": {
          "$ref": "#/entities/DivisionBreakdown",
          "type": "object"
        },
        "stokAkhir": {
          "$ref": "#/entities/DivisionBreakdown",
          "type": "object"
        },
        "minThreshold": {
          "type": "number"
        },
        "criticalThreshold": {
          "type": "number"
        },
        "maxCapacity": {
          "type": "number"
        },
        "unitPrice": {
          "type": "number"
        },
        "supplierName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "warehouseZone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "notes": {
          "type": "string",
          "maxLength": 240
        },
        "status": {
          "type": "string",
          "enum": ["nominal", "low", "critical", "out"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "projectId",
        "ownerId",
        "rowNumber",
        "sku",
        "name",
        "category",
        "unit",
        "currentStock",
        "stokAwal",
        "materialMasuk",
        "materialKeluar",
        "stokAkhir",
        "minThreshold",
        "criticalThreshold",
        "maxCapacity",
        "unitPrice",
        "supplierName",
        "warehouseZone",
        "notes",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "StockMovement": {
      "title": "Stock Movement Ledger",
      "description": "Immutable audit record of material inflow, usage outflow, or stock audit adjustment per division (DIST, AGA, TE, UMUM).",
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "materialId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "materialName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "materialSku": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9\\-_]+$"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "division": {
          "type": "string",
          "enum": ["DIST", "AGA", "TE", "UMUM"]
        },
        "type": {
          "type": "string",
          "enum": ["in", "out", "adjustment"]
        },
        "quantity": {
          "type": "number"
        },
        "previousStock": {
          "type": "number"
        },
        "newStock": {
          "type": "number"
        },
        "referenceNo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "actorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "notes": {
          "type": "string",
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "projectId",
        "ownerId",
        "materialId",
        "materialName",
        "materialSku",
        "unit",
        "division",
        "type",
        "quantity",
        "previousStock",
        "newStock",
        "referenceNo",
        "actorName",
        "notes",
        "createdAt"
      ]
    },
    "StockNotification": {
      "title": "Automatic Stock Notification",
      "description": "Real-time automated alert triggered when active material stock crosses configured warning/critical thresholds or is restocked.",
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "materialId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "materialName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "materialSku": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9\\-_]+$"
        },
        "severity": {
          "type": "string",
          "enum": ["warning", "critical", "out_of_stock", "restocked"]
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "message": {
          "type": "string",
          "minLength": 2,
          "maxLength": 320
        },
        "currentStock": {
          "type": "number"
        },
        "threshold": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "isRead": {
          "type": "boolean"
        },
        "isResolved": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "projectId",
        "ownerId",
        "materialId",
        "materialName",
        "materialSku",
        "severity",
        "title",
        "message",
        "currentStock",
        "threshold",
        "unit",
        "isRead",
        "isResolved",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Warehouse monitoring projects owned by authenticated users."
    },
    "/projects/{projectId}/materials/{materialId}": {
      "schema": { "$ref": "#/entities/Material" },
      "description": "Real-time warehouse material ledger items with DIST/AGA/TE breakdown."
    },
    "/projects/{projectId}/movements/{movementId}": {
      "schema": { "$ref": "#/entities/StockMovement" },
      "description": "Immutable stock movement audit trail linked atomically to material stock updates."
    },
    "/projects/{projectId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/StockNotification" },
      "description": "Automatic low-stock, critical-stock, and restock notifications."
    }
  }
}
